# Скопируй в `.env`. Значения: Supabase → Project Settings → API
# При смене проекта обязательно обнови URL и ключи под новый ref.

VITE_SUPABASE_PROJECT_ID=xsoxordweqrikahxjdxc
VITE_SUPABASE_URL=https://xsoxordweqrikahxjdxc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pazFf0JbM9F41DglsGqGQQ_OjZktURF

# Опционально для Web Push на клиенте
# VITE_VAPID_PUBLIC_KEY=

# Показать в Настройках переключатель «Simulate Pro» (в т.ч. preview/Lovable, не только npm run dev)
# VITE_ENABLE_SIMULATE_PRO_UI=true

# RevenueCat (нативные покупки App Store / Google Play). Публичные SDK-ключи —
# безопасны в клиентском бандле. RevenueCat → Project → API keys.
# Без них покупки на нативе выключаются «мягко» (startCheckout → onUnavailable).
# VITE_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
# Идентификатор entitlement в RevenueCat (по умолчанию "pro"):
# VITE_RC_ENTITLEMENT=pro

# iOS native Google Sign-In client ID. Get from Google Cloud Console:
#   APIs & Services → Credentials → iOS OAuth client → Client ID.
# Without this, native iOS Google sign-in stays hidden / errors gracefully.
# See docs/IOS_AUTH_SETUP.md for the full setup.
# VITE_GOOGLE_IOS_CLIENT_ID=123456-abc.apps.googleusercontent.com

# Sentry crash reporting. Create a project at sentry.io → React.
# Without this, Sentry stays inert (no network, no init cost).
VITE_SENTRY_DSN=https://f5240fd0ad8aeeb78b71fe3b75172fdf@o4511460602216448.ingest.de.sentry.io/4511460606476368
# Optional — sets the release tag so source maps line up:
# VITE_SENTRY_RELEASE=daydraft@1.0.0
# Optional — fraction of transactions to capture for tracing (0–1):
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
